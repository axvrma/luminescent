{
  "name": "luminescent-workspace",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run build:lib && concurrently --kill-others -n library,docs \"npm run dev:build --workspace luminescent\" \"npm run dev --workspace luminescent-docs\"",
    "dev:docs": "npm run build:lib && npm run dev --workspace luminescent-docs",
    "dev:playground": "npm run dev --workspace luminescent",
    "build": "npm run build:docs",
    "build:lib": "npm run build --workspace luminescent",
    "build:docs": "npm run build --workspace luminescent-docs",
    "start": "npm run start --workspace luminescent-docs",
    "lint": "npm run lint --workspaces --if-present",
    "lint:lib": "npm run lint --workspace luminescent",
    "lint:docs": "npm run lint --workspace luminescent-docs",
    "preview": "npm run preview --workspace luminescent",
    "storybook": "npm run storybook --workspace luminescent",
    "build-storybook": "npm run build-storybook --workspace luminescent",
    "prebuild:docs": "npm run build:lib"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
